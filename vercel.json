{
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/provider/:path*",
      "destination": "/provider/:path*"
    },
    {
      "source": "/practice/:path*",
      "destination": "/practice/:path*"
    },
    {
      "source": "/private/:path*",
      "destination": "/private/:path*"
    },
    {
      "source": "/boroughs/:path*",
      "destination": "/boroughs/:path*"
    },
    {
      "source": "/guides/:path*",
      "destination": "/guides/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/data.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
